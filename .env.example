# ─── Site ─────────────────────────────────────────────────────────────
# URL pública definitiva (canonical, sitemap, Open Graph e links do WhatsApp).
# Na Vercel, se vazia, usa o domínio de produção do projeto automaticamente.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ─── Banco de dados (libSQL / SQLite) ────────────────────────────────
# Local: arquivo SQLite. Produção serverless: banco Turso (libsql://...)
# A integração Turso da Vercel cria TURSO_DATABASE_URL/TURSO_AUTH_TOKEN — também aceitos.
DATABASE_URL=file:./data/bragatto.db
DATABASE_AUTH_TOKEN=

# ─── Armazenamento das fotos ─────────────────────────────────────────
# local       = grava em UPLOAD_DIR (servidor próprio/VPS com disco persistente)
# vercel-blob = Vercel Blob (automático quando BLOB_READ_WRITE_TOKEN existe)
# s3          = Cloudflare R2, AWS S3 ou compatível
# Vazio = detecção automática (Blob → S3 → local)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads

BLOB_READ_WRITE_TOKEN=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (domínio do CDN), ex.: https://fotos.seudominio.com.br
S3_PUBLIC_URL=

# ─── Desenvolvimento ─────────────────────────────────────────────────
# Exibe os registros de demonstração (npm run db:seed-demo). Ignorado em produção.
SHOW_DEMO_DATA=false

# ─── Visualização 3D ─────────────────────────────────────────────────
# Hosts autorizados para modelos por URL externa (separados por vírgula).
# O domínio de S3_PUBLIC_URL já é aceito automaticamente.
MODEL3D_ALLOWED_HOSTS=
# Tamanho máximo do arquivo GLB enviado pelo painel (MB)
MODEL3D_MAX_MB=40

# ─── Primeiro acesso ao painel (usado no build da Vercel) ────────────
# Se não houver nenhum usuário, o build cria este administrador. Depois do primeiro
# login, troque a senha no painel e remova ADMIN_PASSWORD das variáveis.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# true = não carregar o estoque inicial no primeiro build
SKIP_INITIAL_SEED=false
