{
  "name": "bragatto-veiculos-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-demo.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-admin.ts",
    "assets:prepare": "python scripts/prepare-assets.py",
    "setup": "npm run db:migrate && npm run db:seed",
    "postinstall": "node scripts/copy-3d-decoders.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
